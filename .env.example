# ---- LLM provider keys (use whichever you have; even 2 models works) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=          # for Grok (xAI)

# ---- Guardian config (optional overrides) ----
# Comma-separated list of LiteLLM model names to fan out to (one per provider).
# Full 5-provider set (requires funded OpenAI + xAI accounts):
#   gpt-4o-mini,anthropic/claude-haiku-4-5-20251001,xai/grok-3,gemini/gemini-2.5-flash,groq/llama-3.3-70b-versatile
GUARDIAN_MODELS=anthropic/claude-haiku-4-5-20251001,gemini/gemini-2.5-flash,groq/llama-3.3-70b-versatile

# Consensus (cosine similarity) thresholds for the verdict.
CONSENSUS_PASS_THRESHOLD=0.70
CONSENSUS_BLOCK_THRESHOLD=0.50

# Server port (Railway injects PORT automatically).
PORT=8000

# Browser dashboard origins allowed to call this API (CORS).
# Comma-separated. Add your deployed dashboard URL here, e.g.
# GUARDIAN_CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
GUARDIAN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Plan enforcement (Supabase) ----
# When BOTH SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set, API-key auth +
# monthly quota enforcement turn ON. Leave blank to run open (dev mode).
# The service-role key is server-side ONLY — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Unlimited internal/admin bypass key (send as 'Authorization: Bearer <key>').
ADMIN_API_KEY=
