# ---- LLM provider keys (use whichever you have; even 2 models works) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Guardian config (optional overrides) ----
# Comma-separated list of LiteLLM model names to fan out to.
GUARDIAN_MODELS=gpt-4o-mini,claude-3-5-sonnet-20240620,gemini/gemini-1.5-flash

# Consensus (cosine similarity) thresholds for the verdict.
CONSENSUS_PASS_THRESHOLD=0.70
CONSENSUS_BLOCK_THRESHOLD=0.50

# Server port (Railway injects PORT automatically).
PORT=8000

# Browser dashboard origins allowed to call this API (CORS).
# Comma-separated. Add your deployed dashboard URL here, e.g.
# GUARDIAN_CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
GUARDIAN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
